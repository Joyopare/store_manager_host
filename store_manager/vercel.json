{
  "version": 2,
  "builds": [
    {
      "src": "store_manager/store_manager/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "buildCommand": "cd store_manager && python manage.py collectstatic --noinput"
      }
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "store_manager/store_manager/wsgi.py"
    }
  ]
}